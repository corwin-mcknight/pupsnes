root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{cpp,h,hpp,cc,cxx,hh,hxx,ipp,inc}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{cmake,yml,yaml,json}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2
