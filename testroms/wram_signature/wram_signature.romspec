rom_name = "wram_signature"
title = "WRAM Signature"
purpose = "Verify the ROM can store a known signature into WRAM after reset."
why_expected_to_fail = "This ROM previously failed before STA long support existed."
cycle_budget = 10
expected_current_status = "pass"

[goal]
name = "loads-signature-value"
description = "Accumulator low byte should contain the signature value before the store."
kind = "cpu_a8"
expected_value = 0x5A

[goal]
name = "writes-signature-to-wram"
description = "WRAM byte at $7E:0000 should hold the signature after the store."
kind = "wram_byte"
address = 0x0000
expected_value = 0x5A
